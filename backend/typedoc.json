{
    "entryPoints": ["src/**/*.ts"],
    "out": "docs",
    "exclude": ["src/**/*.spec.ts", "src/main.ts"],
    "tsconfig": "tsconfig.json",
    "includeVersion": true,
    "excludeExternals": true,
    "excludePrivate": true,
    "excludeProtected": true,
    "excludeNotDocumented": true,
    "excludeInternal": false
  }